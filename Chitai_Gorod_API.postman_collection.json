              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Статус 200', () => pm.response.to.have.status(200));",
                  "const suggests = pm.response.json().included.filter(i => i.type === 'searchPhraseSuggest');",
                  "pm.test('Подсказки есть', () => pm.expect(suggests.length).to.be.above(0));",
                  "pm.test('Каждая подсказка содержит «досто»', () => suggests.forEach(s => pm.expect(s.attributes.plainPhrase.toLowerCase()).to.include('досто')));"
                ]
              }
            }
