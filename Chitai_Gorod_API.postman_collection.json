            "url": {
              "raw": "{{base_url}}/v2/search/product?phrase=Роулинг&customerCityId={{city_id}}&products[page]=1&products[per-page]=10",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v2",
                "search",
                "product"
