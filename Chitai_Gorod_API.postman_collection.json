        {
          "name": "04. Вторая страница выдачи",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Статус 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "const pagination = json.included.find(i => i.type === 'pagination').attributes;",
                  "pm.test('Текущая страница — 2', () => pm.expect(pagination.current_page).to.eql(2));",
                  "pm.test('Размер страницы — 10', () => pm.expect(pagination.per_page).to.eql(10));",
                  "pm.test('На странице 10 товаров', () => pm.expect(json.included.filter(i => i.type === 'product').length).to.eql(10));"
                ]
              }
            }
          ],
