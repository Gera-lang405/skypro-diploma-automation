{
  "info": {
    "_postman_id": "57032617-298f-5ccd-9f2f-ccbb67474b43",
    "name": "API Читай-города — дипломная работа (Селиванов Г.)",
    "description": "Коллекция для API-тест-кейсов дипломной работы. Базовый адрес — переменная base_url (https://web-agr.chitai-gorod.ru/web/api). Запустите запросы по порядку: первый получает анонимный токен и сохраняет его в переменную token, остальные передают его в заголовке Authorization. Позитивных запросов 6 (включая авторизацию), негативных 5. Запрос 11 фиксирует найденный дефект BR-003 и падает, пока дефект не исправлен.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Авторизация",
      "item": [
        {
          "name": "01. Анонимная авторизация — получить токен",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Статус 201', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.test('Токен в формате Bearer', () => pm.expect(json.token.accessToken).to.match(/^Bearer /));",
                  "pm.test('Пользователь анонимный', () => pm.expect(json.user.group).to.eql('anonymous'));",
                  "pm.test('Город выдан, id — число', () => pm.expect(json.city.id).to.be.a('number'));",
                  "// сохранение данных для следующих запросов",
                  "pm.collectionVariables.set('token', json.token.accessToken);",
                  "pm.collectionVariables.set('city_id', json.city.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/v1/auth/anonymous",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "auth",
                "anonymous"
              ],
              "query": []
            },
            "description": "Сервис выдаёт анонимный Bearer-токен без логина и пароля. Токен сохраняется в переменную коллекции token и дальше подставляется в заголовок Authorization.",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "Позитивные",
      "item": [
        {
          "name": "02. Поиск товаров по названию",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Статус 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "const products = json.included.filter(i => i.type === 'product');",
                  "pm.test('Тип результата searchProductResult', () => pm.expect(json.data.type).to.eql('searchProductResult'));",
                  "pm.test('Вернулось 5 товаров', () => pm.expect(products.length).to.eql(5));",
                  "pm.test('У каждого товара есть название и цена > 0', () => products.forEach(p => { pm.expect(p.attributes.title).to.not.be.empty; pm.expect(p.attributes.price).to.be.above(0); }));",
                  "pm.test('Хотя бы одно название содержит «гарри поттер»', () => pm.expect(products.some(p => p.attributes.title.toLowerCase().includes('гарри поттер'))).to.be.true);",
                  "// сохранение id первого найденного товара",
                  "pm.collectionVariables.set('product_id', products[0].id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "{{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/v2/search/product?phrase=гарри поттер&customerCityId={{city_id}}&products[page]=1&products[per-page]=5",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v2",
                "search",
                "product"
              ],
              "query": [
                {
                  "key": "phrase",
                  "value": "гарри поттер"
                },
                {
                  "key": "customerCityId",
                  "value": "{{city_id}}"
                },
                {
                  "key": "products[page]",
                  "value": "1"
                },
                {
                  "key": "products[per-page]",
                  "value": "5"
                }
              ]
            },
            "description": ""
          }
        },
        {
          "name": "03. Поиск товаров по фамилии автора",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Статус 200', () => pm.response.to.have.status(200));",
                  "const products = pm.response.json().included.filter(i => i.type === 'product');",
                  "const lastNames = products.flatMap(p => (p.attributes.authors || []).map(a => a.lastName));",
                  "pm.test('Среди авторов найденных книг есть Роулинг', () => pm.expect(lastNames).to.include('Роулинг'));"
                ]
              }
            }
          ],
